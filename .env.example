NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://CHANGE_DB_USER:CHANGE_DB_PASSWORD@localhost:5432/CHANGE_DB_NAME
REDIS_URL=redis://localhost:6379
PUBLIC_API_URL=http://localhost:3000
# Optional comma-separated STUN URLs. Leave unset to use the built-in Google STUN defaults.
# STUN_SERVER_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN fallback for production. TURN_SERVER_URLS must use a public hostname that browsers can reach.
# TURN_SERVER_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_USERNAME=CHANGE_TURN_USERNAME
# TURN_PASSWORD=CHANGE_TURN_PASSWORD
# DEPLOY_ADMIN_TOKEN=CHANGE_DEPLOY_ADMIN_TOKEN
